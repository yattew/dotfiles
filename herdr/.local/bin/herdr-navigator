#!/bin/bash
DIRECTION=$1
PANE_INFO=$(herdr pane process-info)
PANE_ID=$(echo "$PANE_INFO" | grep -Eo '"pane_id":"[^"]+"' | cut -d'"' -f4 | head -n1)

if echo "$PANE_INFO" | grep -iqE '"name":"n?vim"'; then
    if [ "$DIRECTION" = "left" ]; then
        herdr pane send-keys "$PANE_ID" "ctrl+h"
    elif [ "$DIRECTION" = "down" ]; then
        herdr pane send-keys "$PANE_ID" "ctrl+j"
    elif [ "$DIRECTION" = "up" ]; then
        herdr pane send-keys "$PANE_ID" "ctrl+k"
    elif [ "$DIRECTION" = "right" ]; then
        herdr pane send-keys "$PANE_ID" "ctrl+l"
    fi
else
    herdr pane focus --direction "$DIRECTION" --pane "$PANE_ID"
fi
